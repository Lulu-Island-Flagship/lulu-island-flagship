# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
# Fix (2026-07-24): la Supabase CLI lee sustitución de variables env(...) de
# config.toml (ver [auth.external.google]) desde un .env en la raíz del
# proyecto, DISTINTO del .env.local que lee Next.js -- sin esta línea, un
# .env con el client secret real de Google quedaría trackeado por git.
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scoped tsconfig scratch files used for fast type-checking during audits
# (couldn't be deleted from this sandbox — see EPERM note in audit report;
# ignored here so it never gets committed by accident)
tsconfig.scoped-*.json
tsconfig.verify*.json

# Supabase Studio SQL editor auto-saved snippets (local dev state, not source)
/supabase/snippets/
