# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron jobs (Vercel)
CRON_SECRET=generate-a-strong-random-secret

# URL pública base de la app (usada en redirects de auth, links de comunicaciones
# salientes -- ver src/lib/send-communication.ts -- y otros callbacks). En
# producción debe ser el dominio real, ej. https://luluislandflagship.ca.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal (opcional, solo para primer servicio)
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# BC Assessment (opcional — proveedor externo, nunca se presenta como hecho)
# BC_ASSESSMENT_API_URL=https://api.example.com/bc-assessment
# BC_ASSESSMENT_API_KEY=...

# Geocodificación de direcciones (opcional — proveedor externo usado por
# src/lib/geocode.ts para convertir dirección -> lat/lng, ej. Mapbox/Google
# Geocoding/HERE). Sin estas variables, la geocodificación real simplemente
# no ocurre -- nunca se inventan coordenadas.
# GEOCODER_PROVIDER_URL=https://api.example.com/geocode
# GEOCODER_API_KEY=...

# Google review link (dato del mundo real que debe dar el dueño -- la URL
# corta real de "Escribir una reseña" del perfil de Google Business del
# negocio, ej. https://g.page/r/XXXXXXXXXXXX/review). Sin esto, el botón de
# "Leave a Google Review" en /evaluar simplemente no se muestra -- nunca se
# inventa un link falso.
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/.../review

# ==========================================================================
# Nómina (P0-8, v8.3 E9) — MUY IMPORTANTE
# ==========================================================================
# Clave simétrica de cifrado en reposo para SIN y datos bancarios de
# empleados (supabase/migrations/204_e9_employee_sin_banking_encrypted.sql,
# pgcrypto pgp_sym_encrypt/decrypt). Sin esta variable, el admin NO puede
# capturar el SIN ni los datos bancarios de un empleado (ver
# src/app/api/admin/empleados/[id]/route.ts) -- el endpoint rechaza la
# escritura en vez de guardar sin cifrar. Generar con:
#   openssl rand -base64 32
# NUNCA commitear el valor real. Si se pierde, los datos ya cifrados quedan
# irrecuperables (cifrado simétrico real, no ofuscación reversible) --
# guardar una copia offline segura (gestor de contraseñas del dueño).
# PAYROLL_ENCRYPTION_KEY=

# SMS (P0-2/P0-3, v8.3) — proveedor de Twilio para OTP de verificación
# telefónica (Supabase Auth, config.toml -> [auth.sms.twilio]) y para
# comunicaciones salientes reales (src/lib/sms.ts, implementación B-3).
# Mientras TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN no estén seteadas,
# isSmsProviderConfigured() devuelve false: la verificación telefónica de
# reserva se vuelve opcional (no bloquea al cliente, pero publica una alerta
# en la bandeja unificada del admin) y sendSms() sigue devolviendo
# "not_configured" de forma determinista. En cuanto se setean, la
# verificación vuelve a exigirse automáticamente sin tocar código.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Número de origen E.164 comprado en Twilio (ej. +16045551234) -- sin esto,
# sendSms() sigue devolviendo "not_configured" aunque las dos variables de
# arriba estén seteadas (ver src/lib/sms.ts).
# TWILIO_FROM_NUMBER=
# Número de un humano al que la centralita telefónica escala llamadas que no
# puede resolver el bot (src/app/api/telephony/webhook/route.ts).
# TWILIO_HUMAN_ESCALATION_NUMBER=

# Email (B-3, v8.3) — proveedor de Resend para envío real de comunicaciones
# salientes por email (src/lib/email.ts). Sin RESEND_API_KEY, sendEmail()
# sigue devolviendo "not_configured" de forma determinista (comportamiento
# correcto para dev/staging sin proveedor contratado).
# RESEND_API_KEY=
# Dirección "From" usada en los emails enviados vía Resend. Opcional -- si
# no se setea, se usa un remitente por defecto (ver src/lib/email.ts).
# EMAIL_FROM_ADDRESS=Lulu Island Flagship <noreply@luluislandflagship.ca>

# Observabilidad (opcional) — DSN de Sentry. Sin esto, isObservabilityConfigured()
# (src/lib/observability.ts) devuelve false y no se reporta a ningún proveedor
# externo -- requiere además instalar @sentry/nextjs para activarse de verdad.
# SENTRY_DSN=
