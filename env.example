# Supabase credentials — copy to .env.local and fill with your values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe credentials — get from https://dashboard.stripe.com/apikeys
# Use test keys for development, live keys for production
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cron job secret (generate a random string, e.g. openssl rand -base64 32)
CRON_SECRET=your-random-secret-here

# App URL (used for redirects, e.g. in auth callbacks)
NEXT_PUBLIC_APP_URL=https://luluislandflagship.ca
